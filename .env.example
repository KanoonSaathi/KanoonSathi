# ==============================================================================
# KanoonSaathi Legal Aid Platform - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local in platform/ (or .env in root) and fill in your values.
# The application also includes an automatic persistent JSON fallback if MongoDB
# is not immediately configured.
# ==============================================================================

# Application Server Configuration
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here

# 1. Database - MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kanoonsaathi?retryWrites=true&w=majority

# 2. LLM / AI Triage - Groq API
GROQ_API_KEY=gsk_your_groq_api_key_here

# 3. File Storage - Cloudinary (Cause Vault & Certified Evidentiary Records)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 4. Email & Verification Service - Resend (OTP & Auth Notifications)
RESEND_API_KEY=re_your_resend_api_key_here
